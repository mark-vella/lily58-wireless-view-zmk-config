#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        rect_left_half: rect_left_half {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT>;
            label = "RECT_LEFT_HALF";
        };

        rect_right_half: rect_right_half {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_ALT &kp RIGHT>;
            label = "RECT_RIGHT_HALF";
        };

        rect_two_thirds: rect_right_third {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_ALT &kp E>;
            label = "RECT_RIGHT_THIRD";
        };

        rect_third: rect_left_third {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_ALT &kp D>;
            label = "RECT_LEFT_THIRD";
        };

        rect_three_quarters: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_ALT &kp E &kp LSHIFT>;
            label = "NEW_MACRO";
        };

        rect_quarter: rect_quarter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_ALT &kp D &kp LSHIFT>;
            label = "RECT_QUARTER";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Layer 0";
            bindings = <
&kp ESCAPE               &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                          &kp N6           &kp N7         &kp N8     &kp N9   &kp N0         &kp GRAVE
&kp TAB                  &kp Q   &kp W   &kp E         &kp R         &kp T                           &kp Y            &kp U          &kp I      &kp O    &kp P          &kp MINUS
&mt LEFT_CONTROL ESCAPE  &kp A   &kp S   &kp D         &kp F         &kp G                           &kp H            &kp J          &kp K      &kp L    &kp SEMICOLON  &kp APOS
&kp LSHFT                &kp Z   &kp X   &kp C         &kp V         &kp B   &kp LBKT     &kp RBKT   &kp N            &kp M          &kp COMMA  &kp DOT  &kp FSLH       &kp RSHFT
                                         &kp LEFT_ALT  &kp LEFT_GUI  &mo 1   &kp SPACE    &kp ENTER  &lt 2 BACKSPACE  &kp RIGHT_GUI  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&trans          &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans     &trans     &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans     &trans     &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp PAGE_DOWN  &kp PG_UP  &kp END    &trans  &trans
                                &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans
            >;

            label = "Layer 1";
        };

        layer_2 {
            bindings = <
&trans  &trans    &trans    &trans    &trans      &trans                         &out OUT_USB  &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &studio_unlock  &trans
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6
&trans  &kp LBRC  &kp LPAR  &kp LBKT  &kp EQUAL   &kp MINUS                      &kp BSLH      &kp PIPE      &kp TILDE     &kp GRAVE     &trans          &trans
&trans  &kp RBRC  &kp RPAR  &kp RBKT  &kp PLUS    &kp UNDER    &trans    &trans  &kp F7        &kp F8        &kp F9        &kp F10       &kp F11         &kp F12
                            &trans    &trans      &trans       &trans    &trans  &trans        &trans        &trans
            >;

            label = "Layer 2";
        };
    };
};
