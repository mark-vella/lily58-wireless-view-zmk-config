#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        RECT_LEFT_HALF {
            bindings = <&kp H>;
            key-positions = <50 51>;
            layers = <4>;
        };

        RECT_RIGHT_HALF {
            bindings = <&kp L>;
            key-positions = <50 51>;
            layers = <4>;
        };

        RECT_FULL {
            bindings = <&kp K>;
            key-positions = <50 51>;
            layers = <4>;
        };

        RECT_CENTER {
            bindings = <&kp J>;
            key-positions = <50 51>;
            layers = <4>;
        };

        RECT_ONE_THIRD {
            bindings = <&kp Y>;
            key-positions = <50 51>;
            layers = <4>;
        };

        RECT_ONE_FOURTH {
            bindings = <&kp U>;
            key-positions = <50 51 36>;
            layers = <4>;
        };

        RECT_THREE_FOURTHS {
            bindings = <&kp I>;
            key-positions = <50 51 36>;
            layers = <4>;
        };

        RECT_TWO_THIRDS {
            bindings = <&kp P>;
            key-positions = <50 51>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                                &kp N6           &kp N7        &kp N8     &kp N9   &kp N0    &kp TILDE
&kp TAB    &kp Q   &kp W   &kp E      &kp R     &kp T                                 &kp Y            &kp U         &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LGUI   &kp A   &kp S   &kp D      &kp F     &kp G                                 &kp H            &kp J         &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C      &kp V     &kp B     &kp LBKT       &kp RBKT     &kp N            &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                           &kp LCTRL  &kp LALT  &kp LGUI  &lt 1 SPACE    &lt 2 ENTER  &lt 3 BACKSPACE  &lt 4 DELETE  &mo 5
            >;
        };

        Lower {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans            &trans             &trans                &trans                 &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PERCENT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HASH          &kp EQUAL          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp CARET         &kp DOLLAR         &kp LESS_THAN         &kp GREATER_THAN       &kp TILDE    &trans
                        &trans  &trans  &trans  &trans    &trans  &kp UNDERSCORE    &kp MINUS          &kp PLUS
            >;
        };

        Raise {
            bindings = <
&trans  &trans  &trans     &trans     &trans         &trans                             &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &kp KP_N7  &kp KP_N8  &kp RS(KP_N9)  &trans                             &kp AMPERSAND   &kp SLASH       &kp PIPE      &kp BACKSLASH    &trans  &trans
&trans  &kp AT  &kp KP_N4  &kp KP_N5  &kp KP_N6      &kp KP_NUMBER_0                    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3      &kp STAR         &trans    &trans  &trans          &trans          &trans        &trans           &trans  &trans
                           &trans     &trans         &trans           &trans    &trans  &trans          &trans          &trans
            >;
        };

        Adjust {
            bindings = <
&trans  &bt BT_PRV     &bt BT_NXT  &trans  &trans  &trans                    &trans            &trans                 &trans                &trans  &trans         &trans
&trans  &trans         &trans      &trans  &trans  &trans                    &trans            &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC  &trans  &trans         &trans
&trans  &trans         &trans      &trans  &trans  &trans                    &kp K_MUTE2       &kp RS(K_VOLUME_DOWN)  &kp K_VOL_UP          &trans  &trans         &trans
&trans  &kp C_AC_SAVE  &trans      &trans  &trans  &trans  &trans    &trans  &kp C_PLAY_PAUSE  &kp C_PREV             &kp C_NEXT            &trans  &kp C_AC_SAVE  &trans
                                   &trans  &trans  &trans  &trans    &trans  &trans            &trans                 &trans
            >;
        };

        Fun {
            bindings = <
&kp LCTRL  &trans   &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp F12  &kp F7  &kp F8  &kp F9  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp F11  &kp F4  &kp F5  &kp F6  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp F10  &kp F1  &kp F2  &kp F3  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        Macros {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
